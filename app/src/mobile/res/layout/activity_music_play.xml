<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12141A">

    <!-- 背景取色（沉浸模式：封面模糊大图） -->
    <ImageView
        android:id="@+id/npBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.25" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 顶部：关闭 + 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/npClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="✕"
                android:textSize="18sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/npTitleTop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="middle"
                android:text="正在播放"
                android:textSize="15sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 封面（沉浸：取色融合背景） -->
        <ImageView
            android:id="@+id/npCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:scaleType="centerCrop"
            android:contentDescription="封面" />

        <!-- 歌词（可滚动，当前行高亮） -->
        <LinearLayout
            android:id="@+id/npLyricWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/npLyricTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="歌词"
                android:textSize="12sp"
                android:textColor="#8A8F99" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/npLyricScroll"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:id="@+id/npLyricList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <!-- 标题/歌手 -->
        <TextView
            android:id="@+id/npTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="歌曲名"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/npSinger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="歌手"
            android:textSize="14sp"
            android:textColor="#8A8F99" />

        <!-- 进度条 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/npSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/npPos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="00:00"
                    android:textSize="11sp"
                    android:textColor="#8A8F99" />

                <TextView
                    android:id="@+id/npDur"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="00:00"
                    android:textSize="11sp"
                    android:textColor="#8A8F99" />
            </LinearLayout>
        </LinearLayout>

        <!-- 控制按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/npPrev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⏮"
                android:textSize="22sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/npPlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⏸"
                android:textSize="32sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/npNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⏭"
                android:textSize="22sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
