<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/navigation" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="@color/transparent"
        app:elevation="0dp"
        app:itemIconTint="@color/selector_nav"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/menu_nav" />

    <!-- ★ 侧边版块导航遮罩：默认隐藏，弹出时点它收起 -->
    <FrameLayout
        android:id="@+id/sideNavOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- ★ 侧边版块导航栏（视频/音乐/阅读）：距顶 60dp，【左侧】顶部对齐，默认隐藏 -->
    <LinearLayout
        android:id="@+id/sideNav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="60dp"
        android:background="@drawable/bg_side_nav"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <!-- ★ 应用图标：镂空无底色，慢速向右旋转（动画在 Java 里挂） -->
        <ImageView
            android:id="@+id/sideAppIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_launcher_fg" />

        <!-- ★ 应用名：根据宽度自动调整大小 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/sideAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="18sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeTextType="uniform" />

        <!-- ★ 版块按钮：纵向可滚动 -->
        <ScrollView
            android:id="@+id/sideScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sideVod"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_side_nav_item"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="视频（点播）"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sideMusic"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_side_nav_item"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="音乐（待开发）"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sideRead"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_side_nav_item"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="阅读（待开发）"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</RelativeLayout>
