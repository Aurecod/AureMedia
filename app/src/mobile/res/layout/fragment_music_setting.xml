<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12141A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- 音源管理 block（对标 src-list + src-add-panel） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1D26"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="音源管理"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="可添加多个 · 指定平台 · 支持本地 JS"
                android:textSize="12sp"
                android:textColor="#8A8F99" />

            <!-- 音源列表 -->
            <LinearLayout
                android:id="@+id/srcList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <!-- 添加面板 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/srcName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#2A2E37"
                    android:padding="12dp"
                    android:hint="名称，如：星河入梦 / 松间听雨 / 我的源"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A8F99"
                    android:textSize="14sp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/srcJsUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#2A2E37"
                    android:padding="12dp"
                    android:hint="JS 在线地址 https://…/xxx.js"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A8F99"
                    android:textSize="14sp"
                    android:singleLine="true" />

                <!-- 平台多选 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="对接平台（可多选）"
                    android:textSize="12sp"
                    android:textColor="#8A8F99" />

                <LinearLayout
                    android:id="@+id/srcPlats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />

                <!-- 导入按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSrcAdd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#3B82F6"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:text="在线导入"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnSrcLocal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="#2A2E37"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:text="本地文件"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- seg 行容器（音质/外观/歌词等，对标 set-row） -->
        <LinearLayout
            android:id="@+id/settingRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
